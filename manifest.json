{
  "manifest_version": 3,
  "name": "Private Form Assistant",
  "version": "1.0.0",
  "description": "An on-demand, local-only form filling assistant.",
  "permissions": ["activeTab", "scripting", "storage"],
  "action": {
    "default_title": "Private Form Assistant",
    "default_popup": "popup.html"
  },
  "options_page": "options.html"
}
